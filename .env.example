# Copy to `.env` (never commit it) or export these in your shell.
# Full reference: README "Configuration".

# Preferred auth: Qoder personal access token (SDK Worker runtime).
QODER_PERSONAL_ACCESS_TOKEN=

# Region hint for login messages: auto (default) | global | cn.
QODER_REGION=auto

# Probe model for the live-catalog discovery query. Default: auto.
PI_QODER_DEFAULT_MODEL=auto

# Live discovery timeout in ms (1000-60000). Default: 10000.
PI_QODER_DISCOVERY_TIMEOUT_MS=10000

# Set to 1/true to skip live discovery (offline / fast startup, fallbacks only).
PI_QODER_DISABLE_DISCOVERY=

# Token streaming is on by default (SDK partial frames). Set to 1/true to
# fall back to complete-message delivery.
PI_QODER_DISABLE_PARTIALS=

# Per-control-request timeout in ms for turns (bounds stalls like a hanging
# "initialize"). Default: 60000 (10s-5min). Lower = fail fast, higher = patience.
PI_QODER_CONTROL_TIMEOUT_MS=60000

# Budget in ms for the first SDK message of a turn (independent watchdog:
# the SDK's own initialize timeout is hardcoded). Default: 60000 (10s-5min).
PI_QODER_INIT_TIMEOUT_MS=60000

# Grace period in ms for SDK shutdown. Default: 2000 (0-30s).
PI_QODER_CLOSE_GRACE_MS=2000

# Cap on SDK agent goal pursuits per turn (positive int; omitted by default).
PI_QODER_GOAL_MAX_TURNS=

# Forward --debug to the qodercli child (verbose). CLI stderr is captured in
# the debug log whenever debugging is on, independent of this flag.
PI_QODER_SDK_DEBUG=

# Isolated on-disk state dir. Default: ~/.config/pi-qoder-bridge.
PI_QODER_BRIDGE_STATE_DIR=

# Verbose startup/status notices. Set to 1 to enable.
PI_QODER_BRIDGE_DEBUG=
