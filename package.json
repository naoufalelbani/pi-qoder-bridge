{
  "name": "pi-qoder-bridge",
  "version": "0.2.0",
  "description": "Qoder provider extension for pi.dev (pi coding agent) powered by the official @qoder-ai/qoder-agent-sdk.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-dev",
    "qoder",
    "qoder-ai",
    "qoder-agent-sdk",
    "coding-agent"
  ],
  "author": "Naoufal EL BANI",
  "license": "MIT",
  "homepage": "https://github.com/naoufalelbani/pi-qoder-bridge#readme",
  "bugs": {
    "url": "https://github.com/naoufalelbani/pi-qoder-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naoufalelbani/pi-qoder-bridge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "1.0.50",
    "typebox": "^1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
